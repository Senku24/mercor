# Copy this file to `.env` and replace the placeholder with your real connection string.
# Runtime connection string for PostgreSQL. On Neon use the DIRECT string (no "-pooler"
# in the host): Prisma 8's runtime sends a startup parameter the Neon pooler rejects.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Optional. Connection string used only by `prisma migration` commands via
# prisma.config.ts (falls back to DATABASE_URL); the running API never reads it.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

OPENAI_API_KEY="sk-proj-replace-me"

# Optional GitHub token (no scopes needed). Without it GitHub allows 60 requests/hour
# per IP, which shared hosts such as Render exhaust quickly (pre-interview returns 502).
# GITHUB_TOKEN="github_pat_replace-me"
FRONTEND_ORIGIN="http://localhost:3000"
REALTIME_MODEL="gpt-realtime-2.1"
SCORING_MODEL="gpt-5-mini"

# Optional. Interface the API binds to. Development default is 0.0.0.0;
# production sets 127.0.0.1 so Nginx is the only public entry point.
HOST="0.0.0.0"
PORT="3001"

# Optional. Express "trust proxy" setting: "loopback" (default, local Nginx) or a hop
# count such as "1" behind a hosted proxy like Render.
TRUST_PROXY="loopback"
