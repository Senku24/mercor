// use prisma-8


model Interview {
  id              String    @id @onCreate(uuid())
  githubMetaData  Json
  accessToken     String
  clientSecretIssued Boolean @default(false)
  callId          String?
  status          InterviewStatus
  score           Int?
  feedback        String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  conversations   Message[]
}

model Message {
  id              String    @id @onCreate(uuid())
  message         String
  type            MessageType
  interviewId     String
  createdAt       DateTime  @default(now())
  interview       Interview  @relation(fields: [interviewId] , references: [id])
}

enum  MessageType {
  User
  Assistant
}

enum  InterviewStatus {
  Pre
  InProgress
  Done
}
