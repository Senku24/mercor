// use prisma-8


model Interview {
  id              String    @id @onCreate(uuid()) 
  githubMetaData  Json
  status          InterviewStatus
  score           Int       @default(0)
  conversations   Message[]
}

model Message {
  id              String    @id @onCreate(uuid()) 
  message         String
  type            MessageType
  interviewId     String
  interview       Interview  @relation(fields: [interviewId] , references: [id])
}

enum  MessageType {
  User
  Assistant
}

enum  InterviewStatus {
  Pre
  InProgress
  Done
}